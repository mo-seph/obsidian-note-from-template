{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "target": "es2025",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    // "allowImportingTsExtensions": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "noImplicitAny": true,
    "importHelpers": true,
    "lib": [
      "dom",
      "ES2025",
      "scripthost",
    ]
  },
  "include": [
    "**/*.ts"
  ]
}
